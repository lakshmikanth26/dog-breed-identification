# Dog Breed Identification App - Environment Variables

# FREE AI APIs (Choose one or more)

# Hugging Face Inference API (FREE - Recommended!)
# Get free token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# DeepAI API (FREE tier available)
# Get free API key from: https://deepai.org/
DEEPAI_API_KEY=your_deepai_key_here

# Google Gemini AI (OPTIONAL - has strict limits)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration (Optional)
FLASK_ENV=development
PORT=5000

# App Configuration (Optional)
SKIP_DOG_CHECK=false
